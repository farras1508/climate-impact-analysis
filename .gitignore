# ---- Data layers (never commit; regenerated by pipeline) ----
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
# Small hand-made crosswalks ARE source code -> allow explicitly
!data/external/country_crosswalk.csv

# ---- Large scientific binaries ----
*.nc
*.nc4
*.grib
*.grib2
*.h5
*.hdf5
*.zarr/
*.parquet
*.feather

# ---- Models & experiment tracking ----
/models/
/mlruns/
/mlartifacts/

# ---- Secrets ----
.env
.cdsapirc
*.key

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- R ----
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/

# ---- Generated reports (keep the source .qmd/.md, ignore renders) ----
reports/profiling/
reports/*_files/
*.html

# ---- OS / editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/